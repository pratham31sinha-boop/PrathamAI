{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "panda_valley.html", "use": "@vercel/static" },
    { "src": "hill_climb_racing.html", "use": "@vercel/static" },
    { "src": "gta6.html", "use": "@vercel/static" },
    { "src": "auth/mobile-callback.html", "use": "@vercel/static" }
  ],
  "functions": {
    "api/app.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/app.py" },
    { "src": "/auth/(.*)", "dest": "/api/app.py" },
    { "src": "/config/(.*)", "dest": "/api/app.py" },
    { "src": "/chat-stream", "dest": "/api/app.py" },
    { "src": "/download/(.*)", "dest": "/api/app.py" },
    { "src": "/download_file(.*)", "dest": "/api/app.py" },
    { "src": "/download_temp_file(.*)", "dest": "/api/app.py" },
    { "src": "/PrathamAI.apk", "dest": "/api/app.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
